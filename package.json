{
  "name": "footbid",
  "version": "0.1.0",
  "private": true,
  "description": "Competitive 1v1 football auction and tactical battle web game.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names WEB,API --prefix-colors cyan,green \"npm run dev --workspace=@footbid/web\" \"npm run start:dev --workspace=@footbid/api\"",
    "dev:web": "npm run dev --workspace=@footbid/web",
    "dev:api": "npm run start:dev --workspace=@footbid/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:api": "npm run test --workspace=@footbid/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}
